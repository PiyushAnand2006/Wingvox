{
  "name": "wingvox-desktop",
  "productName": "Wingvox",
  "version": "1.0.0",
  "description": "Wingvox desktop shell — capture-protected overlay window",
  "author": "Piyush Anand",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wingvox.desktop",
    "productName": "Wingvox",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      { "from": "../index.html", "to": "app/index.html" },
      { "from": "../css", "to": "app/css" },
      { "from": "../js", "to": "app/js" },
      { "from": "../assets", "to": "app/assets" }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "../assets/logo/wingvox-mark-256.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "../assets/logo/wingvox-mark-512.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
